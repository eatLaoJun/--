{
  "name": "forgepilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ForgePilot: bug-fix and PR-review agent platform with durable execution, layered context and offline evaluation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "demo:fix": "tsx scripts/demo.ts fix",
    "demo:review": "tsx scripts/demo.ts review",
    "demo:swebench": "tsx scripts/demo-swebench.ts",
    "demo:fault": "tsx scripts/demo.ts fault"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
